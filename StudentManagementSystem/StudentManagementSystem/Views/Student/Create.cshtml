@model Student

<h2>Add Student</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="StudentNumber" class="form-label"></label>

        <input asp-for="StudentNumber"
               class="form-control" />

        <span asp-validation-for="StudentNumber"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>

        <input asp-for="FirstName"
               class="form-control" />

        <span asp-validation-for="FirstName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>

        <input asp-for="LastName"
               class="form-control" />

        <span asp-validation-for="LastName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <div class="mb-3">

        <label asp-for="Faculty" class="form-label"></label>

        <select asp-for="FacultyId"
                id="facultyDropdown"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.Faculties, "FacultyId", "FacultyName"))">

            <option value="">-- Select Faculty --</option>

        </select>

        <span asp-validation-for="FacultyId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Programme" class="form-label"></label>

        <select asp-for="ProgrammeId"
                id="programmeDropdown"
                class="form-select">

            <option value="">-- Select Programme --</option>

        </select>

            

        <span asp-validation-for="ProgrammeId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">
        <label asp-for="YearLevel" class="form-label"></label>

        <input asp-for="YearLevel"
               class="form-control" />

        <span asp-validation-for="YearLevel"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Student
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $("#facultyDropdown").change(function () {

            var facultyId = $(this).val();

            $("#programmeDropdown").empty();

            $("#programmeDropdown").append(
                '<option value="">-- Select Programme --</option>');

            if (facultyId === "")
                return;

            $.getJSON("/Student/GetProgrammes",
                { facultyId: facultyId },
                function (data) {

                    $.each(data, function (index, programme) {

                        $("#programmeDropdown").append(

                            '<option value="' +
                            programme.programmeId +
                            '">' +
                            programme.programmeName +
                            '</option>');

                    });

                });

        });

    </script>
}