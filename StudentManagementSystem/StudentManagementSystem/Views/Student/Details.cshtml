@model Student

<h2>Student Details</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">Student Number</dt>
    <dd class="col-sm-9">@Model.StudentNumber</dd>

    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Faculty</dt>
    <dd class="col-sm-9">@Model.Faculty?.FacultyName</dd>

    <dt class="col-sm-3">Programme</dt>
    <dd class="col-sm-9">@Model.Programme?.ProgrammeName</dd>

    <dt class="col-sm-3">Year Level</dt>
    <dd class="col-sm-9">@Model.YearLevel</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Registration Date</dt>
    <dd class="col-sm-9">
        @Model.RegistrationDate.ToString("dd MMMM yyyy")
    </dd>

</dl>

<hr />

<a asp-action="Edit"
   asp-route-id="@Model.StudentNumber"
   class="btn btn-warning">
    Edit
</a>
<a asp-action="Delete"
   asp-route-id="@Model.StudentNumber"
   class="btn btn-danger">
    Delete
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>