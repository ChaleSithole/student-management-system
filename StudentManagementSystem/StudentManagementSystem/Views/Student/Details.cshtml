@model Student
@using StudentManagementSystem.Models

@{
    ViewData["Title"] = "Student Details";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h3 class="mb-0">
            Student Profile
        </h3>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <table class="table table-borderless">

                    <tr>
                        <th width="35%">Student Number</th>
                        <td>@Model.StudentNumber</td>
                    </tr>

                    <tr>
                        <th>Full Name</th>
                        <td>@Model.FirstName @Model.LastName</td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>

                    <tr>
                        <th>Phone</th>
                        <td>@Model.Phone</td>
                    </tr>

                    <tr>
                        <th>Date of Birth</th>
                        <td>@Model.DateOfBirth.ToString("dd MMMM yyyy")</td>
                    </tr>

                    <tr>
                        <th>Faculty</th>
                        <td>@Model.Faculty?.FacultyName</td>
                    </tr>

                    <tr>
                        <th>Programme</th>
                        <td>@Model.Programme?.ProgrammeName</td>
                    </tr>

                </table>

            </div>

            <div class="col-md-6">

                <table class="table table-borderless">

                    <tr>
                        <th width="35%">Year Level</th>
                        <td>@Model.YearLevel</td>
                    </tr>

                    <tr>
                        <th>Registration Date</th>
                        <td>@Model.RegistrationDate.ToString("dd MMMM yyyy")</td>
                    </tr>

                    <tr>
                        <th>Status</th>

                        <td>

                            @switch (Model.Status)
                            {
                                case StudentStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;

                                case StudentStatus.Graduated:
                                    <span class="badge bg-primary">Graduated</span>
                                    break;

                                case StudentStatus.Suspended:
                                    <span class="badge bg-warning text-dark">Suspended</span>
                                    break;

                                case StudentStatus.Deregistered:
                                    <span class="badge bg-danger">Deregistered</span>
                                    break;
                            }

                        </td>

                    </tr>

                </table>

            </div>

        </div>

    </div>

    <div class="card-footer">

        <a asp-action="Edit"
           asp-route-id="@Model.StudentNumber"
           class="btn btn-warning">
            Edit Student
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>

</div>