@model Student

<div class="card shadow">

    <div class="card-header bg-warning">

        <h3 class="mb-0">
            Edit Student
        </h3>

    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="StudentNumber" class="form-label"></label>

        <input asp-for="StudentNumber"
               class="form-control"
               readonly />

        <input type="hidden" asp-for="StudentNumber" />

        <span asp-validation-for="StudentNumber"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>

        <input asp-for="FirstName"
               class="form-control" />

        <span asp-validation-for="FirstName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>

        <input asp-for="LastName"
               class="form-control" />

        <span asp-validation-for="LastName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <div class="mb-3">

        <label asp-for="Phone" class="form-label"></label>

        <input asp-for="Phone"
               class="form-control" />

        <span asp-validation-for="Phone"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="DateOfBirth" class="form-label"></label>

        <input asp-for="DateOfBirth"
               type="date"
               class="form-control"
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />

        <span asp-validation-for="DateOfBirth"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="FacultyId" class="form-label"></label>

        <select asp-for="FacultyId"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.Faculties, "FacultyId", "FacultyName"))">

            <option value="">-- Select Faculty --</option>

        </select>

        <span asp-validation-for="FacultyId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="ProgrammeId" class="form-label"></label>

        <select asp-for="ProgrammeId"
                class="form-select"
                asp-items="@(new SelectList(ViewBag.Programmes, "ProgrammeId", "ProgrammeName"))">

            <option value="">-- Select Programme --</option>

        </select>

        <span asp-validation-for="ProgrammeId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="YearLevel" class="form-label"></label>

        <select asp-for="YearLevel" class="form-select">

            @for (int i = 1; i <= 6; i++)
            {
                <option value="@i">@i</option>
            }

        </select>

        <span asp-validation-for="YearLevel"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Status" class="form-label"></label>

        <select asp-for="Status"
                class="form-select"
                asp-items="Html.GetEnumSelectList<StudentManagementSystem.Models.StudentStatus>()">
        </select>

        <span asp-validation-for="Status"
              class="text-danger"></span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Student
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

        </form>

    </div>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $("#FacultyId").change(function () {

            var facultyId = $(this).val();

            $("#ProgrammeId").empty();

            $("#ProgrammeId").append(
                '<option value="">-- Select Programme --</option>');

            if (facultyId === "")
                return;

            $.getJSON("/Student/GetProgrammes",
                { facultyId: facultyId },
                function (data) {

                    $.each(data, function (index, programme) {

                        $("#ProgrammeId").append(

                            '<option value="' +
                            programme.programmeId +
                            '">' +
                            programme.programmeName +
                            '</option>');

                    });

                });

        });

    </script>
}