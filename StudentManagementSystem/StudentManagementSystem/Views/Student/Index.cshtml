@model IEnumerable<Student>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<h2>Student Management</h2>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5>Total Students</h5>
                <h2>@ViewBag.TotalStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5>Active</h5>
                <h2>@ViewBag.ActiveStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-secondary">
            <div class="card-body">
                <h5>Graduated</h5>
                <h2>@ViewBag.GraduatedStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h5>Suspended</h5>
                <h2>@ViewBag.SuspendedStudents</h2>
            </div>
        </div>
    </div>

</div>
<p class="text-muted">
    Manage all registered students.
</p>

<div class="row mb-3">

    <div class="col-md-6">

        <form asp-action="Index" method="get">

            <div class="input-group">

                <input type="text"
                       name="searchString"
                       class="form-control"
                       placeholder="Search by student number, first name or last name"
                       value="@Context.Request.Query["searchString"]" />

                <button class="btn btn-primary"
                        type="submit">
                    Search
                </button>

            </div>

        </form>

    </div>

    <div class="col-md-6 text-end">

        <a asp-action="Create"
           class="btn btn-success">
            + Add Student
        </a>

    </div>

</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Student Number</th>
            <th>Name</th>
            <th>Faculty</th>
            <th>Programme</th>
            <th>Year</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentNumber</td>
                <td>@student.FirstName @student.LastName</td>
                <td>@student.Faculty?.FacultyName</td>
                <td>@student.Programme?.ProgrammeName</td>
                <td>@student.YearLevel</td>
                <td>@student.Status</td>
                <td>

                    <a asp-action="Details"
                       asp-route-id="@student.StudentNumber"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@student.StudentNumber"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                        asp-route-id="@student.StudentNumber"
                        class="btn btn-danger btn-sm"
                        onclick="return confirm('Are you sure you want to delete this student?');">
                        Delete
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>