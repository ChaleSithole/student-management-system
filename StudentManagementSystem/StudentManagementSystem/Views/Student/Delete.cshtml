@model Student

<h2>Delete Student</h2>

<h3>Are you sure you want to delete this student?</h3>

<hr />

<p>
    <strong>Student Number:</strong>
    @Model.StudentNumber
</p>

<p>
    <strong>Name:</strong>
    @Model.FirstName @Model.LastName
</p>

<p>
    <strong>Programme:</strong>
    @Model.Programme
</p>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="StudentNumber" />

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>