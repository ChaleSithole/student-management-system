@model Student

<div class="card shadow">

    <div class="card-header bg-danger text-white">

        <h3 class="mb-0">
            Delete Student
        </h3>

    </div>

    <div class="card-body">

        <div class="alert alert-warning">

            <strong>Warning!</strong>

            This action cannot be undone.

        </div>

        <table class="table table-bordered">

            <tr>
                <th width="35%">Student Number</th>
                <td>@Model.StudentNumber</td>
            </tr>

            <tr>
                <th>Name</th>
                <td>@Model.FirstName @Model.LastName</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>

            <tr>
                <th>Phone</th>
                <td>
                    @(string.IsNullOrWhiteSpace(Model.Phone)
                        ? "Not provided"
                        : Model.Phone)
                </td>
            </tr>

            <tr>
                <th>Date of Birth</th>
                <td>@Model.DateOfBirth.ToString("dd MMMM yyyy")</td>
            </tr>

            <tr>
                <th>Age</th>
                <td>
                    @{
                        var age = DateTime.Today.Year - Model.DateOfBirth.Year;

                        if (Model.DateOfBirth.Date > DateTime.Today.AddYears(-age))
                        {
                            age--;
                        }
                    }

                    @age years
                </td>
            </tr>

            <tr>
                <th>Faculty</th>
                <td>@Model.Faculty?.FacultyName</td>
            </tr>

            <tr>
                <th>Programme</th>
                <td>@Model.Programme?.ProgrammeName</td>
            </tr>

        </table>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   name="studentNumber"
                   value="@Model.StudentNumber" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Student
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>