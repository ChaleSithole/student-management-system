@model IEnumerable<StudentManagementSystem.Models.ViewModels.ProgrammeListViewModel>

@{
    ViewData["Title"] = "Programmes";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Programme Management</h2>

    <a asp-action="Create"
       class="btn btn-success">

        + Add Programme

    </a>

</div>

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5>Total Programmes</h5>
                <h2>@ViewBag.TotalProgrammes</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>Total Students</h5>
                <h2>@ViewBag.TotalStudents</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5>Total Faculties</h5>
                <h2>@ViewBag.TotalFaculties</h2>
            </div>
        </div>
    </div>

</div>

<table class="table table-striped table-hover">

    <thead>

        <tr>

            <th>ID</th>
            <th>Programme</th>
            <th>Faculty</th>
            <th class="text-center">Students</th>
            <th width="220">Actions</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Programme.ProgrammeId</td>

                <td>@item.Programme.ProgrammeName</td>

                <td>@item.Programme.Faculty?.FacultyName</td>

                <td class="text-center">

                    <span class="badge bg-success">

                        @item.StudentCount

                    </span>

                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Programme.ProgrammeId"
                       class="btn btn-warning btn-sm">

                        Edit

                    </a>

                    @if (item.CanDelete)
                    {
                        <a asp-action="Delete"
                           asp-route-id="@item.Programme.ProgrammeId"
                           class="btn btn-danger btn-sm">

                            Delete

                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm"
                                disabled>

                            Delete

                        </button>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>