@model StudentManagementSystem.Models.Programme

<h2>Delete Programme</h2>

<div class="alert alert-warning">

    Are you sure you want to delete this programme?

</div>

<div class="card">

    <div class="card-body">

        <h4>@Model.ProgrammeName</h4>

        <p>

            Faculty:

            <strong>

                @Model.Faculty?.FacultyName

            </strong>

        </p>

    </div>

</div>

<br />

<form asp-action="Delete">

    <input asp-for="ProgrammeId"
           type="hidden" />

    <button class="btn btn-danger">

        Delete Programme

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>