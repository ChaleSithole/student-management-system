@model StudentManagementSystem.Models.Programme

<h2>Edit Programme</h2>

<hr />

<form asp-action="Edit" method="post">

    <input asp-for="ProgrammeId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">

        <label asp-for="ProgrammeName"
               class="form-label"></label>

        <input asp-for="ProgrammeName"
               class="form-control" />

        <span asp-validation-for="ProgrammeName"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="FacultyId"
               class="form-label"></label>

        <select asp-for="FacultyId"
                asp-items="ViewBag.Faculties"
                class="form-select">
        </select>

    </div>

    <button class="btn btn-primary">

        Save Changes

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}