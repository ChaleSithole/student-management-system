@model StudentManagementSystem.Models.Faculty

@{
    ViewData["Title"] = "Add Faculty";
}

<h2>Add Faculty</h2>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="FacultyName"
               class="form-label">
        </label>

        <input asp-for="FacultyName"
               class="form-control" />

        <span asp-validation-for="FacultyName"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">

        Save Faculty

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}