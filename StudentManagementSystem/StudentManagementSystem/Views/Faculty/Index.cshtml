@model IEnumerable<StudentManagementSystem.Models.ViewModels.FacultyListViewModel>

@{
    ViewData["Title"] = "Faculties";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]

        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]

        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between mb-3">

    <h2>Faculties</h2>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5>Total Faculties</h5>
                    <h2>@ViewBag.TotalFaculties</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5>Total Programmes</h5>
                    <h2>@ViewBag.TotalProgrammes</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5>Total Students</h5>
                    <h2>@ViewBag.TotalStudents</h2>
                </div>
            </div>
        </div>

    </div>

    <a asp-action="Create"
       class="btn btn-success">

        + Add Faculty

    </a>

</div>

<table class="table table-striped table-hover">

    <thead>

        <tr>

            <th>ID</th>

            <th>Faculty</th>

            <th class="text-center">Programmes</th>

            <th class="text-center">Students</th>

            <th width="220">Actions</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Faculty.FacultyId</td>

                <td>@item.Faculty.FacultyName</td>

                <td class="text-center">

                    <span class="badge bg-primary">

                        @item.ProgrammeCount

                    </span>

                </td>

                <td class="text-center">

                    <span class="badge bg-success">

                        @item.StudentCount

                    </span>

                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Faculty.FacultyId"
                       class="btn btn-warning btn-sm">

                        Edit

                    </a>

                    @if (item.CanDelete)
                    {
                        <a asp-action="Delete"
                           asp-route-id="@item.Faculty.FacultyId"
                           class="btn btn-danger btn-sm">

                            Delete

                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm"
                                disabled
                                title="Faculty contains programmes">

                            Delete

                        </button>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>