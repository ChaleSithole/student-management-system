@model StudentManagementSystem.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5">

    <h1 class="display-4 fw-bold">
        Student Management System
    </h1>

    <h3 class="text-secondary">
        University Administration Dashboard
    </h3>

    <p class="lead mt-3">

        Welcome back,

        <strong>
            @(User.IsInRole("Administrator")
                ? "Administrator"
                : "Lecturer")
        </strong>.

    </p>

</div>

<div class="row g-4 mb-5">

    <div class="col-md-3">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body text-center">
                <h5>Students</h5>
                <h1>@Model.TotalStudents</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body text-center">
                <h5>Faculties</h5>
                <h1>@Model.TotalFaculties</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-info shadow h-100">
            <div class="card-body text-center">
                <h5>Programmes</h5>
                <h1>@Model.TotalProgrammes</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-dark shadow h-100">
            <div class="card-body text-center">
                <h5>Active</h5>
                <h1>@Model.ActiveStudents</h1>
            </div>
        </div>
    </div>

</div>

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h4 class="mb-0">
            Quick Actions
        </h4>

    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-3 d-grid">
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="Student"
                       asp-action="Create"
                       class="btn btn-success">
                        Add Student
                    </a>
                }
            </div>

            <div class="col-md-3 d-grid">
                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">
                    Manage Students
                </a>
            </div>

            @if (User.IsInRole("Administrator"))
            {
                <div class="col-md-3 d-grid">

                    <a asp-controller="Faculty"
                       asp-action="Index"
                       class="btn btn-warning btn-lg">

                        Manage Faculties

                    </a>

                </div>
            }

            @if (User.IsInRole("Administrator"))
            {
                <div class="col-md-3 d-grid">

                    <a asp-controller="Faculty"
                       asp-action="Index"
                       class="btn btn-warning btn-lg">

                        Manage Pogrammes

                    </a>

                </div>
            }

        </div>

    </div>

</div>